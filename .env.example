# BotFather'dan olingan token
BOT_TOKEN=

# Base44: Dashboard -> API -> Create access token (Full access)
BASE44_TOKEN=

# Ilova ID (o'zgartirish shart emas)
BASE44_APP_ID=6ac34a8ddcf74b8abf6b0872

# Bob qo'shish huquqi beriladigan chat ID'lar (vergul bilan): 123456789,987654321
ADMIN_IDS=

# Cloudinary (sayt ishlatayotgan sozlamalar)
CLOUDINARY_CLOUD_NAME=kfzjpgh5
CLOUDINARY_UPLOAD_PRESET=AniManxwa

# Sayt manzili (havola namunasida ko'rsatiladi)
SITE_URL=https://animanxwa.base44.app

# Sahifalarni yuborish usuli: photo (albom, tez) yoki document (siqilmaydi)
PAGE_SEND_MODE=photo

# --- PDF va rasmlarni bo'laklash ---
# Bitta bo'lak balandligi (px). Shundan balandroq rasm bo'laklarga bo'linadi. 0 = bo'lmaslik
SLICE_HEIGHT=1500

# true: kesish joyi chizma o'rtasidan emas, bo'sh joydan tanlanadi
SMART_CUT=true

# JPEG sifati (1-100)
JPEG_QUALITY=90

# Havola orqali yuklanadigan fayl uchun eng katta hajm (MB)
MAX_FILE_MB=80
